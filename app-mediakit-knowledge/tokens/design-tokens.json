{
  "$description": "app-mediakit-knowledge design tokens — DTCG format (design-tokens.github.io/community-group/format). Source of truth for the theme-neutral base :root block of static/tokens.css, generated by build.rs. Each leaf's \"$var\" is the exact CSS custom-property suffix (after \"--k-\") — kept explicit rather than derived from the JSON path because the shipped variable names predate this file and don't follow one uniform prefix rule (e.g. color.surface -> --k-surface, not --k-color-surface). Per-tenant accent overrides, dark-mode overrides, and the prefers-color-scheme block are theme/selector-conditional and live in tokens/theme-overrides.css instead — DTCG has no stable multi-mode standard yet.",
  "font": {
    "sans":    { "$type": "fontFamily", "$var": "font-sans",    "$value": "\"Inter\", system-ui, -apple-system, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif" },
    "serif":   { "$type": "fontFamily", "$var": "font-serif",   "$value": "\"Source Serif 4\", Georgia, \"Times New Roman\", serif" },
    "display": { "$type": "fontFamily", "$var": "font-display", "$value": "\"Playfair Display\", Georgia, \"Times New Roman\", serif" },
    "mono":    { "$type": "fontFamily", "$var": "font-mono",    "$value": "ui-monospace, \"SFMono-Regular\", \"Menlo\", \"Consolas\", monospace" }
  },
  "text": {
    "2xs":  { "$type": "dimension", "$var": "text-2xs",  "$value": "0.6875rem", "$description": "11px — badge, legal fine print" },
    "xs":   { "$type": "dimension", "$var": "text-xs",   "$value": "0.75rem",   "$description": "12px — sitenotice, footer meta" },
    "sm":   { "$type": "dimension", "$var": "text-sm",   "$value": "0.8125rem", "$description": "13px — controls, nav links" },
    "base": { "$type": "dimension", "$var": "text-base", "$value": "0.875rem",  "$description": "14px — chrome baseline (Vector register)" },
    "md":   { "$type": "dimension", "$var": "text-md",   "$value": "1rem",      "$description": "16px — search input" },
    "lg":   { "$type": "dimension", "$var": "text-lg",   "$value": "1.125rem",  "$description": "18px — logo wordmark" },
    "xl":   { "$type": "dimension", "$var": "text-xl",   "$value": "1.375rem",  "$description": "22px" },
    "2xl":  { "$type": "dimension", "$var": "text-2xl",  "$value": "1.75rem",   "$description": "28px" },
    "footer-heading": { "$type": "dimension", "$var": "text-footer-heading", "$value": "1.0625rem", "$description": "17px — footer column headings; a deliberate off-scale step (not md/16 or lg/18) matching bim.woodfinegroup.com's own legibility-audit value, adopted 2026-07-16 after that heading size was found to read as fine print at 2xs" }
  },
  "leading": {
    "tight":   { "$type": "number", "$var": "leading-tight",   "$value": 1.25 },
    "snug":    { "$type": "number", "$var": "leading-snug",    "$value": 1.4 },
    "normal":  { "$type": "number", "$var": "leading-normal",  "$value": 1.55 },
    "relaxed": { "$type": "number", "$var": "leading-relaxed", "$value": 1.6, "$description": "footer link-list rhythm — bim.woodfinegroup.com precedent, 2026-07-16" }
  },
  "weight": {
    "regular":  { "$type": "fontWeight", "$var": "weight-regular",  "$value": 400 },
    "medium":   { "$type": "fontWeight", "$var": "weight-medium",   "$value": 500 },
    "semibold": { "$type": "fontWeight", "$var": "weight-semibold", "$value": 600 },
    "bold":     { "$type": "fontWeight", "$var": "weight-bold",     "$value": 700 }
  },
  "tracking": {
    "wide": { "$type": "dimension", "$var": "tracking-wide", "$value": "0.02em" },
    "caps": { "$type": "dimension", "$var": "tracking-caps", "$value": "0.06em", "$description": "uppercase sitenotice entity / footer titles" }
  },
  "color": {
    "surface":             { "$type": "color", "$var": "surface",             "$value": "#ffffff",              "$description": "header, content canvas" },
    "surface-sunken":      { "$type": "color", "$var": "surface-sunken",      "$value": "#f8f9fa",              "$description": "sitenotice + footer institutional gray" },
    "surface-raised":      { "$type": "color", "$var": "surface-raised",      "$value": "#ffffff",              "$description": "drawer panel" },
    "surface-inset":       { "$type": "color", "$var": "surface-inset",       "$value": "#f8f9fa",              "$description": "search field fill" },
    "surface-inset-hover": { "$type": "color", "$var": "surface-inset-hover", "$value": "#eaecf0" },
    "overlay-scrim":       { "$type": "color", "$var": "overlay-scrim",       "$value": "rgba(32, 33, 34, 0.45)" },

    "ink":            { "$type": "color", "$var": "ink",            "$value": "#202122", "$description": "near-black primary" },
    "ink-secondary":  { "$type": "color", "$var": "ink-secondary",  "$value": "#54595d", "$description": "muted secondary" },
    "ink-muted":      { "$type": "color", "$var": "ink-muted",      "$value": "#646a70", "$description": "meta / captions — darkened for AA on gray" },
    "ink-disabled":   { "$type": "color", "$var": "ink-disabled",   "$value": "#a2a9b1" },
    "ink-inverse":    { "$type": "color", "$var": "ink-inverse",    "$value": "#ffffff" },

    "border":        { "$type": "color", "$var": "border",        "$value": "#a2a9b1", "$description": "header bottom rule, footer top rule" },
    "border-light":  { "$type": "color", "$var": "border-light",  "$value": "#c8ccd1" },
    "border-subtle": { "$type": "color", "$var": "border-subtle", "$value": "#eaecf0", "$description": "faint dividers" },

    "link":           { "$type": "color", "$var": "link",           "$value": "#3366cc" },
    "link-hover":     { "$type": "color", "$var": "link-hover",     "$value": "#2a4b8d" },
    "link-active":    { "$type": "color", "$var": "link-active",    "$value": "#faa700", "$description": "Vector active/pressed link" },
    "link-visited":   { "$type": "color", "$var": "link-visited",   "$value": "#795cb2" },
    "link-underline": { "$type": "color", "$var": "link-underline", "$value": "transparent" },

    "accent":        { "$type": "color", "$var": "accent",        "$value": "#1a4480", "$description": "default (documentation navy); [data-instance] overrides in theme-overrides.css" },
    "accent-hover":  { "$type": "color", "$var": "accent-hover",  "$value": "#14345f" },
    "accent-active": { "$type": "color", "$var": "accent-active", "$value": "#0f2747" },
    "accent-soft":   { "$type": "color", "$var": "accent-soft",   "$value": "rgba(26, 68, 128, 0.10)", "$description": "focus wash only" },
    "accent-ink":    { "$type": "color", "$var": "accent-ink",    "$value": "#ffffff", "$description": "text on an accent fill" }
  },
  "component-surface": {
    "header-bg":       { "$type": "color", "$var": "header-bg",       "$value": "{color.surface}" },
    "sitenotice-bg":   { "$type": "color", "$var": "sitenotice-bg",   "$value": "{color.surface-sunken}" },
    "footer-bg":       { "$type": "color", "$var": "footer-bg",       "$value": "#eef1f5", "$description": "distinct from surface-sunken 2026-08-25 (Command/project-editorial UI-fix batch) — was sharing a token with .k-compliance directly above it, blending into one undifferentiated gray mass. Cool navy-tinted gray, consistent with --k-accent's navy." },
    "drawer-bg":       { "$type": "color", "$var": "drawer-bg",       "$value": "{color.surface-raised}" },
    "search-bg":       { "$type": "color", "$var": "search-bg",       "$value": "{color.surface-inset}" },
    "search-bg-hover": { "$type": "color", "$var": "search-bg-hover", "$value": "{color.surface-inset-hover}" }
  },
  "focus": {
    "ring":       { "$type": "shadow", "$var": "focus-ring",       "$value": "0 0 0 2px var(--k-surface), 0 0 0 4px var(--k-accent)" },
    "ring-inset": { "$type": "shadow", "$var": "focus-ring-inset", "$value": "inset 0 0 0 2px var(--k-accent)" },
    "outline":    { "$type": "string", "$var": "focus-outline",    "$value": "2px solid var(--k-accent)" }
  },
  "badge": {
    "border": { "$type": "color", "$var": "badge-border", "$value": "{color.accent}" },
    "ink":    { "$type": "color", "$var": "badge-ink",     "$value": "{color.accent}" },
    "bg":     { "$type": "color", "$var": "badge-bg",      "$value": "transparent" }
  },
  "space": {
    "0": { "$type": "dimension", "$var": "space-0", "$value": "0" },
    "1": { "$type": "dimension", "$var": "space-1", "$value": "0.25rem", "$description": "4" },
    "2": { "$type": "dimension", "$var": "space-2", "$value": "0.5rem",  "$description": "8" },
    "3": { "$type": "dimension", "$var": "space-3", "$value": "0.75rem", "$description": "12" },
    "4": { "$type": "dimension", "$var": "space-4", "$value": "1rem",    "$description": "16" },
    "5": { "$type": "dimension", "$var": "space-5", "$value": "1.5rem",  "$description": "24" },
    "6": { "$type": "dimension", "$var": "space-6", "$value": "2rem",    "$description": "32" },
    "7": { "$type": "dimension", "$var": "space-7", "$value": "3rem",    "$description": "48" },
    "8": { "$type": "dimension", "$var": "space-8", "$value": "4rem",    "$description": "64" }
  },
  "geometry": {
    "header-height":     { "$type": "dimension", "$var": "header-height",     "$value": "3.5rem", "$description": "56px" },
    "sitenotice-height": { "$type": "dimension", "$var": "sitenotice-height", "$value": "2rem",   "$description": "32px" },
    "sidebar-width":     { "$type": "dimension", "$var": "sidebar-width",     "$value": "12rem",  "$description": "192px — Vector 2022 uses 13rem; our labels are short" },
    "content-max":       { "$type": "string",    "$var": "content-max",      "$value": "none",  "$description": "fill viewport (gutters only); the P3 left sidebar will re-form the 2-column" },
    "search-max":        { "$type": "dimension", "$var": "search-max",       "$value": "480px" },
    "drawer-width":      { "$type": "dimension", "$var": "drawer-width",     "$value": "min(20rem, 84vw)" },
    "gutter":            { "$type": "dimension", "$var": "gutter",           "$value": "{space.5}" },
    "gutter-lg":         { "$type": "dimension", "$var": "gutter-lg",        "$value": "{space.7}" }
  },
  "radius": {
    "none": { "$type": "dimension", "$var": "radius-none", "$value": "0" },
    "xs":   { "$type": "dimension", "$var": "radius-xs",   "$value": "2px" },
    "sm":   { "$type": "dimension", "$var": "radius-sm",   "$value": "3px" },
    "md":   { "$type": "dimension", "$var": "radius-md",   "$value": "4px" },
    "pill": { "$type": "dimension", "$var": "radius-pill", "$value": "999px" }
  },
  "shadow": {
    "none":   { "$type": "string", "$var": "shadow-none",   "$value": "none" },
    "sm":     { "$type": "shadow", "$var": "shadow-sm",     "$value": "0 1px 2px rgba(32, 33, 34, 0.08)" },
    "header": { "$type": "shadow", "$var": "shadow-header", "$value": "0 1px 0 var(--k-border)" },
    "drawer": { "$type": "shadow", "$var": "shadow-drawer", "$value": "2px 0 12px rgba(32, 33, 34, 0.18)" },
    "footer": { "$type": "shadow", "$var": "shadow-footer", "$value": "0 -10px 24px -20px rgba(11, 35, 64, 0.28)", "$description": "footer elevation — bim.woodfinegroup.com precedent, 2026-07-16. Paired with a top-edge gradient wash left as a literal in app.css (composited with --k-footer-bg per-theme; no gradient $type precedent in this file yet)" }
  },
  "motion": {
    "fast":     { "$type": "duration",    "$var": "motion-fast", "$value": "120ms" },
    "base":     { "$type": "duration",    "$var": "motion-base", "$value": "180ms" },
    "slow":     { "$type": "duration",    "$var": "motion-slow", "$value": "240ms" },
    "ease":     { "$type": "cubicBezier", "$var": "ease",        "$value": [0.2, 0, 0.2, 1] },
    "ease-out": { "$type": "cubicBezier", "$var": "ease-out",    "$value": [0.16, 1, 0.3, 1] }
  },
  "zindex": {
    "base":      { "$type": "number", "$var": "z-base",      "$value": 0 },
    "header":    { "$type": "number", "$var": "z-header",    "$value": 100 },
    "overlay":   { "$type": "number", "$var": "z-overlay",   "$value": 200 },
    "drawer":    { "$type": "number", "$var": "z-drawer",    "$value": 210 },
    "skip-link": { "$type": "number", "$var": "z-skip-link", "$value": 300 }
  },
  "prose": {
    "font":    { "$type": "fontFamily", "$var": "prose-font",    "$value": "{font.sans}", "$description": "Wikipedia pairing: SANS reading body + SERIF headings (see title-font)" },
    "fs":      { "$type": "dimension",  "$var": "prose-fs",      "$value": "1rem", "$description": "16px — Wikipedia sans reading size" },
    "leading": { "$type": "number",     "$var": "prose-leading", "$value": 1.6 },
    "measure": { "$type": "dimension",  "$var": "prose-measure", "$value": "44rem", "$description": "~72ch line length" },
    "gap":     { "$type": "dimension",  "$var": "prose-gap",     "$value": "1.1em", "$description": "paragraph rhythm" },
    "ink":     { "$type": "color",      "$var": "prose-ink",     "$value": "{color.ink}" }
  },
  "title": {
    "font": { "$type": "fontFamily", "$var": "title-font", "$value": "{font.serif}", "$description": "Article title + section headings — SERIF (Source Serif 4, Wikipedia stack)" },
    "fs":   { "$type": "dimension",  "$var": "title-fs",   "$value": "2.125rem", "$description": "34px h1" }
  },
  "heading": {
    "h2-fs": { "$type": "dimension", "$var": "h2-fs",        "$value": "1.5rem", "$description": "24px section" },
    "h3-fs": { "$type": "dimension", "$var": "h3-fs",        "$value": "1.2rem", "$description": "19px sub-section" },
    "rule":  { "$type": "color",     "$var": "heading-rule", "$value": "{color.border-light}" }
  },
  "table": {
    "border":    { "$type": "color",     "$var": "table-border",   "$value": "{color.border-light}" },
    "head-bg":   { "$type": "color",     "$var": "table-head-bg",  "$value": "{color.surface-sunken}" },
    "head-ink":  { "$type": "color",     "$var": "table-head-ink", "$value": "{color.ink}" },
    "stripe":    { "$type": "color",     "$var": "table-stripe",   "$value": "color-mix(in srgb, var(--k-surface-sunken) 55%, var(--k-surface))" },
    "cell-pad":  { "$type": "string",    "$var": "table-cell-pad", "$value": "0.45rem 0.7rem" },
    "fs":        { "$type": "dimension", "$var": "table-fs",       "$value": "0.9375rem" }
  },
  "code": {
    "font":       { "$type": "fontFamily", "$var": "code-font",       "$value": "{font.mono}" },
    "fs":         { "$type": "dimension",  "$var": "code-fs",         "$value": "0.875em" },
    "block-bg":   { "$type": "color",      "$var": "code-block-bg",  "$value": "#f6f8fa" },
    "block-ink":  { "$type": "color",      "$var": "code-block-ink", "$value": "#1f2328" },
    "border":     { "$type": "color",      "$var": "code-border",    "$value": "{color.border-subtle}" },
    "inline-bg":  { "$type": "color",      "$var": "code-inline-bg", "$value": "color-mix(in srgb, var(--k-surface-sunken) 70%, var(--k-surface))" },
    "inline-ink": { "$type": "color",      "$var": "code-inline-ink", "$value": "{color.ink}", "$description": "ink, not a loud colour — code-dense prose" },
    "radius":     { "$type": "dimension",  "$var": "code-radius",    "$value": "{radius.md}" }
  },
  "quote": {
    "rule": { "$type": "color", "$var": "quote-rule", "$value": "{color.accent}" },
    "ink":  { "$type": "color", "$var": "quote-ink",  "$value": "{color.ink-secondary}" }
  }
}
